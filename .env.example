PORT=3000
# Destination Slack/Mattermost incoming webhook (required). Comma-separated = fan-out.
REAL_WEBHOOK_URL=test
# Public URL of this proxy (required if Slack cloud must fetch images).
# Example: https://bambuddy-proxy.example.com
PUBLIC_BASE_URL=http://localhost:3000
IMAGE_TTL_HOURS=72
MAX_IMAGE_BYTES=10000000
# REQUIRED for Slack-format photo URLs: Bambuddy serves snapshots at
# /api/v1/archives/.../photos/....jpg behind API-key auth.
# Create in Bambuddy: Settings > API Keys > Create (Read Status scope).
BAMBUDDY_API_KEY=test
# Optional: require on incoming POSTs (?token= or Authorization: Bearer).
INCOMING_TOKEN=
